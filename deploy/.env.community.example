# 复制到仓库根目录 .env.community，chmod 600 后填写真实值。
# 所有密钥均使用独立随机值；不要复用邮箱、服务器或数据库登录密码。
IMAGE_TAG=
HTTP_PORT=8080

SITE_NAME=ZBRS 技术工具工坊
SITE_DOMAIN=example.com
ACME_EMAIL=service@example.com
ICP_BEIAN_NUMBER=
PUBLIC_SECURITY_BEIAN_NUMBER=
PUBLIC_SECURITY_BEIAN_URL=

# 依法可公开的信息处理者名称和专用隐私请求渠道。
PRIVACY_PROCESSOR_NAME=
PRIVACY_CONTACT=

# 游戏出版批文号，或主管部门/专业律师书面确认文件的内部索引；不得填 ICP 号。
PUBLIC_GAME_CLEARANCE_REFERENCE=

# 至少 48 字符的独立随机 JWT 密钥；认证令牌 pepper 至少 32 字符。
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
AUTH_TOKEN_PEPPER=

DB_USERNAME=webfish
DB_PASSWORD=
DB_DATABASE=webfish_community
DB_POOL_MAX=15
DB_MIGRATE_POOL_MAX=5
# 生产必须保持 false；预检和 Compose 均会拒绝/忽略开启完整 SQL 日志。
DB_LOGGING=false

# Redis 密码使用不含空格、引号、冒号、斜杠和 @ 的 32 字符以上随机值。
REDIS_PASSWORD=

# 小规模首发可使用内置基础规则；接入外部审核服务后改为 false 并填写下方地址与令牌。
CHAT_BUILTIN_MODERATION_ENABLED=false
CHAT_MODERATION_ENDPOINT=
CHAT_MODERATION_API_TOKEN=

# 后端通过受保护 HTTPS webhook 投递验证码。接收方必须验证 Bearer token，
# 且不得在响应、日志或监控标签中记录验证码正文。
AUTH_EMAIL_WEBHOOK_URL=https://mail-service.example.com/webhooks/auth-email
AUTH_EMAIL_WEBHOOK_TOKEN=
# 32 字节随机值的无填充 base64url（43 字符），例如 Node crypto.randomBytes(32).toString('base64url')。
AUTH_EMAIL_OUTBOX_ENCRYPTION_KEY=
AUTH_EMAIL_OUTBOX_ENCRYPTION_KEY_ID=v1

# 仅开启身份核验功能时填写。回调地址固定使用本站 HTTPS API，密钥与 provider token 必须独立生成。
SOCIAL_VERIFICATION_PROVIDER_NAME=
SOCIAL_VERIFICATION_PROVIDER_SESSION_URL=
SOCIAL_VERIFICATION_CALLBACK_URL=
SOCIAL_VERIFICATION_PROVIDER_TOKEN=
SOCIAL_VERIFICATION_CALLBACK_SECRET=

# 首批邀请制注册的引导码；生产至少 16 字符，数据库只保存摘要。
BETA_BOOTSTRAP_CODE=
BETA_BOOTSTRAP_USES=100
COMMUNITY_MAX_ACTIVE_USERS=4000

# 前后端由同一组开关生成。先以 false 部署并完成烟测，再逐项开启。
FEATURE_REGISTRATION_ENABLED=false
FEATURE_PASSWORD_RESET_ENABLED=false
FEATURE_SOCIAL_VERIFICATION_ENABLED=false
FEATURE_ACCOUNT_DELETION_ENABLED=false
FEATURE_COMMUNITY_WRITES_ENABLED=false
FEATURE_COMMUNITY_CONTENT_ENABLED=false
FEATURE_COMMUNITY_CONTENT_WRITES_ENABLED=false
FEATURE_COMMUNITY_MODERATION_ENABLED=false
FEATURE_COMMUNITY_CHAT_ENABLED=false
FEATURE_COMMUNITY_CHAT_WRITES_ENABLED=false
FEATURE_COMMUNITY_NEWS_ENABLED=false
FEATURE_NEWS_ADMIN_ENABLED=false
FEATURE_COMMUNITY_BATTLE_ENABLED=false

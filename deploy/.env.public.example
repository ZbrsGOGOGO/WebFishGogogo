# 复制到仓库根目录 .env.public 后填写真实信息。
IMAGE_TAG=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

SITE_NAME=摸摸公司
SITE_DOMAIN=example.com
ACME_EMAIL=service@example.com

# 仅显示在隐私政策，不显示在首页。请使用依法可公开的处理者名称与专用渠道。
PRIVACY_PROCESSOR_NAME=
PRIVACY_CONTACT=

# 填写游戏出版审批批文号，或主管部门/专业律师书面确认文件的内部索引。
# 仅有 ICP 备案号不能替代这一项。
PUBLIC_GAME_CLEARANCE_REFERENCE=

ICP_BEIAN_NUMBER=
PUBLIC_SECURITY_BEIAN_NUMBER=
PUBLIC_SECURITY_BEIAN_URL=

# 复制到仓库根目录 .env.review 后填写真实信息。
IMAGE_TAG=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

SITE_NAME=ZBRS 技术工具工坊
SITE_DOMAIN=example.com
SITE_OPERATOR=请填写与备案申请一致的网站主办者名称
SITE_CONTACT=service@example.com

# 未取得编号时保持为空，禁止填写虚假或占位备案号。
ICP_BEIAN_NUMBER=

# 网站开通后依法办理公安联网备案；取得编号和查询链接后再填写。
PUBLIC_SECURITY_BEIAN_NUMBER=
PUBLIC_SECURITY_BEIAN_URL=

# 复制到仓库根目录的 .env.production 后再填写真实值：
#   cp deploy/.env.example .env.production

# 镜像标签用于区分每次发布，例如 Git commit SHA。
IMAGE_TAG=

# 只监听宿主机回环地址，由宿主机 Caddy/Nginx 提供公网 HTTPS。
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# JWT_SECRET 生产环境至少 32 字符；下面几个密钥可分别用 openssl rand -hex 20 生成。
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 同源部署可留空。只有额外前端域名直连 API 时才填写，多个域名用逗号分隔。
CORS_ORIGIN=

DB_USERNAME=webfish
DB_PASSWORD=
DB_DATABASE=webfish
DB_LOGGING=false

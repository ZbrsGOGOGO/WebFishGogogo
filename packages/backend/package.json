{
  "name": "@stealth-reader/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ZBRS 技术工具工坊 NestJS API",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/main.worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "community-role:set": "node dist/scripts/set-community-role.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/typeorm": "^11.0.3",
    "@stealth-reader/shared": "*",
    "bcrypt": "^6.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "redis": "^5.8.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/ws": "^8.18.1",
    "fast-check": "^3.23.1",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.14",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2"
  }
}
